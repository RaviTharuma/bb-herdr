{
  "name": "bb-plugin-herdr",
  "version": "0.2.0",
  "type": "module",
  "description": "Run BB process hosts in Herdr panes without replacing native providers.",
  "files": [
    "dist",
    "PLUGIN_OVERVIEW.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/server.js",
    "./runner": "./dist/runner.js"
  },
  "bin": {
    "bb-herdr-runner": "./dist/runner.js"
  },
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Herdr process host",
    "description": "Run BB process hosts in supervised Herdr panes.",
    "branding": {
      "icon": "PanelsTopLeft"
    },
    "server": "./src/server.ts"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "bb plugin build .",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "tsc -p tsconfig.json --noEmit && bb plugin build ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "@get-bb/plugin-sdk": "0.6.49"
  }
}
